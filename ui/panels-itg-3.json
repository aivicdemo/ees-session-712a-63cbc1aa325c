      "screenId": "scr-1794401466084",
      "panelHtml": "<style>\n:root {\n  --primary: #2563eb;\n  --primary-hover: #1d4ed8;\n  --bg-main: #f8fafc;\n  --bg-card: #ffffff;\n  --bg-sidebar: #f1f5f9;\n  --border: #e2e8f0;\n  --border-width: 1px;\n  --text: #1e293b;\n  --text-muted: #64748b;\n  --top-bar-bg: #1e293b;\n  --top-bar-border: #0f172a;\n  --top-bar-text: #f1f5f9;\n  --font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"Roboto\", \"Oxygen\", \"Ubuntu\", \"Cantarell\", \"Fira Sans\", \"Droid Sans\", \"Helvetica Neue\", sans-serif;\n  --space-unit: 8px;\n  --control-height: 36px;\n  --radius-card: 6px;\n  --radius-control: 4px;\n  --shadow-card: 0 1px 3px rgba(15, 23, 42, 0.08), 0 1px 2px rgba(15, 23, 42, 0.04);\n  --motion-duration: 200ms;\n  --surface-texture: linear-gradient(135deg, rgba(226, 232, 240, 0.3) 0%, rgba(226, 232, 240, 0) 100%);\n  --surface-texture-size: 100% 100%;\n  --surface-texture-position: 0 0;\n}\n\n* {\n  margin: 0;\n  padding: 0;\n  box-sizing: border-box;\n}\n\nhtml, body {\n  height: 100%;\n  font-family: var(--font-family);\n  color: var(--text);\n  background-color: var(--bg-main);\n}\n\nbody {\n  display: flex;\n  flex-direction: column;\n}\n\n[data-aivic-shell-pattern=\"sidebar\"] {\n  display: flex;\n  height: 100vh;\n  overflow: hidden;\n}\n\n.shell-top-bar {\n  position: fixed;\n  top: 0;\n  left: 0;\n  right: 0;\n  height: 56px;\n  background-color: var(--top-bar-bg);\n  border-bottom: var(--border-width) solid var(--top-bar-border);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 0 calc(var(--space-unit) * 2);\n  z-index: 100;\n  box-shadow: var(--shadow-card);\n}\n\n.shell-logo {\n  display: flex;\n  align-items: center;\n  gap: calc(var(--space-unit) * 1.5);\n  font-size: 14px;\n  font-weight: 600;\n  color: var(--top-bar-text);\n}\n\n.shell-logo-icon {\n  width: 28px;\n  height: 28px;\n  background-color: var(--primary);\n  border-radius: var(--radius-control);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 12px;\n  font-weight: 700;\n  color: white;\n}\n\n.shell-user-area {\n  display: flex;\n  align-items: center;\n  gap: calc(var(--space-unit) * 1.5);\n}\n\n.shell-user-avatar {\n  width: 32px;\n  height: 32px;\n  border-radius: 50%;\n  background-color: var(--primary);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 13px;\n  font-weight: 600;\n  color: white;\n}\n\n.shell-user-name {\n  font-size: 13px;\n  color: var(--top-bar-text);\n}\n\n.shell-logout {\n  font-size: 12px;\n  color: var(--top-bar-text);\n  text-decoration: none;\n  transition: color var(--motion-duration);\n}\n\n.shell-logout:hover {\n  color: var(--primary);\n}\n\n.shell-sidebar {\n  position: fixed;\n  left: 0;\n  top: 56px;\n  bottom: 0;\n  width: 240px;\n  background-color: var(--bg-sidebar);\n  border-right: var(--border-width) solid var(--border);\n  overflow-y: auto;\n  padding: calc(var(--space-unit) * 2) 0;\n  z-index: 99;\n}\n\n.shell-nav {\n  display: flex;\n  flex-direction: column;\n  gap: 0;\n}\n\n.shell-nav-item {\n  display: block;\n  padding: calc(var(--space-unit) * 1.5) calc(var(--space-unit) * 2);\n  font-size: 13px;\n  color: var(--text);\n  text-decoration: none;\n  cursor: pointer;\n  transition: background-color var(--motion-duration), color var(--motion-duration);\n  border-left: 3px solid transparent;\n}\n\n.shell-nav-item:hover {\n  background-color: rgba(37, 99, 235, 0.08);\n  color: var(--primary);\n}\n\n.shell-nav-item.aivic-active {\n  background-color: rgba(37, 99, 235, 0.12);\n  color: var(--primary);\n  border-left-color: var(--primary);\n  font-weight: 500;\n}\n\n.content-area {\n  margin-left: 240px;\n  margin-top: 56px;\n  flex: 1;\n  overflow-y: auto;\n  background-color: var(--bg-main);\n  background-image: var(--surface-texture);\n  background-size: var(--surface-texture-size);\n  background-position: var(--surface-texture-position);\n}\n\n[data-aivic-panel] {\n  width: 100%;\n  min-height: 100%;\n}\n\n.shell-scrollbar {\n  scrollbar-width: thin;\n  scrollbar-color: rgba(100, 116, 139, 0.3) transparent;\n}\n\n.shell-scrollbar::-webkit-scrollbar {\n  width: 6px;\n}\n\n.shell-scrollbar::-webkit-scrollbar-track {\n  background: transparent;\n}\n\n.shell-scrollbar::-webkit-scrollbar-thumb {\n  background-color: rgba(100, 116, 139, 0.3);\n  border-radius: 3px;\n}\n\n.shell-scrollbar::-webkit-scrollbar-thumb:hover {\n  background-color: rgba(100, 116, 139, 0.5);\n}\n  </style>\n\n    <style>\n      [data-aivic-panel=\"scr-1794401466084\"] {\n        padding: calc(var(--space-unit) * 3);\n        display: flex;\n        flex-direction: column;\n        gap: calc(var(--space-unit) * 3);\n      }\n\n      .page-header {\n        display: flex;\n        flex-direction: column;\n        gap: calc(var(--space-unit) * 1);\n      }\n\n      .page-title {\n        font-size: 20px;\n        font-weight: 600;\n        color: var(--text);\n      }\n\n      .breadcrumb {\n        font-size: 12px;\n        color: var(--text-muted);\n      }\n\n      .breadcrumb span:not(:last-child)::after {\n        content: \" \";\n      }\n\n      .main-container {\n        display: grid;\n        grid-template-columns: 1fr 1.2fr 0.8fr;\n        gap: calc(var(--space-unit) * 2);\n      }\n\n      .left-pane {\n        display: flex;\n        flex-direction: column;\n        gap: calc(var(--space-unit) * 2);\n      }\n\n      .search-section {\n        background: var(--bg-card);\n        border: var(--border-width) solid var(--border);\n        border-radius: var(--radius-card);\n        padding: calc(var(--space-unit) * 2);\n        display: flex;\n        flex-direction: column;\n        gap: calc(var(--space-unit) * 1.5);\n      }\n\n      .search-group {\n        display: flex;\n        gap: calc(var(--space-unit) * 1);\n        align-items: flex-end;\n      }\n\n      .form-group {\n        flex: 1;\n      }\n\n      .form-label {\n        display: block;\n        font-size: 12px;\n        font-weight: 600;\n        color: var(--text);\n        margin-bottom: calc(var(--space-unit) * 0.5);\n      }\n\n      .form-input {\n        width: 100%;\n        height: var(--control-height);\n        padding: calc(var(--space-unit) * 0.75) calc(var(--space-unit) * 1);\n        border: var(--border-width) solid var(--border);\n        border-radius: var(--radius-control);\n        font-size: 13px;\n        background: var(--bg-card);\n        color: var(--text);\n      }\n\n      .form-input:focus {\n        outline: none;\n        border-color: var(--primary);\n        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);\n      }\n\n      .button {\n        height: var(--control-height);\n        padding: calc(var(--space-unit) * 0.75) calc(var(--space-unit) * 1.5);\n        border: none;\n        border-radius: var(--radius-control);\n        font-size: 13px;\n        font-weight: 500;\n        cursor: pointer;\n        transition: all var(--motion-duration);\n        white-space: nowrap;\n      }\n\n      .button-primary {\n        background: var(--primary);\n        color: white;\n      }\n\n      .button-primary:hover {\n        background: var(--primary-hover);\n      }\n\n      .button-secondary {\n        background: var(--bg-card);\n        color: var(--text);\n        border: var(--border-width) solid var(--border);\n      }\n\n      .button-secondary:hover {\n        background: rgba(37, 99, 235, 0.08);\n        border-color: var(--primary);\n      }\n\n      .section-title {\n        font-size: 14px;\n        font-weight: 600;\n        color: var(--text);\n        margin-bottom: calc(var(--space-unit) * 1);\n      }\n\n      .table-container {\n        background: var(--bg-card);\n        border: var(--border-width) solid var(--border);\n        border-radius: var(--radius-card);\n        overflow: hidden;\n        box-shadow: var(--shadow-card);\n      }\n\n      .scrollable-table {\n        overflow-y: auto;\n        max-height: 400px;\n      }\n\n      table {\n        width: 100%;\n        border-collapse: collapse;\n        font-size: 13px;\n      }\n\n      thead {\n        background: rgba(37, 99, 235, 0.05);\n        position: sticky;\n        top: 0;\n      }\n\n      th {\n        padding: calc(var(--space-unit) * 1);\n        text-align: left;\n        font-weight: 600;\n        color: var(--text);\n        border-bottom: var(--border-width) solid var(--border);\n      }\n\n      td {\n        padding: calc(var(--space-unit) * 1);\n        border-bottom: var(--border-width) solid var(--border);\n        color: var(--text);\n      }\n\n      tbody tr {\n        cursor: pointer;\n        transition: background-color var(--motion-duration);\n      }\n\n      tbody tr:hover {\n        background-color: rgba(37, 99, 235, 0.05);\n      }\n\n      tbody tr.active {\n        background-color: rgba(37, 99, 235, 0.12);\n      }\n\n      .middle-pane {\n        display: flex;\n        flex-direction: column;\n        gap: calc(var(--space-unit) * 2);\n      }\n\n      .card-group {\n        display: grid;\n        grid-template-columns: 1fr;\n        gap: calc(var(--space-unit) * 2);\n      }\n\n      .card {\n        background: var(--bg-card);\n        border: var(--border-width) solid var(--border);\n        border-radius: var(--radius-card);\n        padding: calc(var(--space-unit) * 2);\n        box-shadow: var(--shadow-card);\n      }\n\n      .metric-cards {\n        display: grid;\n        grid-template-columns: repeat(3, 1fr);\n        gap: calc(var(--space-unit) * 1.5);\n      }\n\n      .metric-card {\n        background: var(--bg-card);\n        border: var(--border-width) solid var(--border);\n        border-radius: var(--radius-card);\n        padding: calc(var(--space-unit) * 1.5);\n        text-align: center;\n        box-shadow: var(--shadow-card);\n      }\n\n      .metric-label {\n        font-size: 12px;\n        color: var(--text-muted);\n        margin-bottom: calc(var(--space-unit) * 0.5);\n        font-weight: 500;\n      }\n\n      .metric-value {\n        font-size: 20px;\n        font-weight: 600;\n        color: var(--primary);\n      }\n\n      .metric-unit {\n        font-size: 11px;\n        color: var(--text-muted);\n        margin-top: calc(var(--space-unit) * 0.25);\n      }\n\n      .chart-container {\n        width: 100%;\n        height: 300px;\n        background: rgba(37, 99, 235, 0.05);\n        border: var(--border-width) dashed var(--border);\n        border-radius: var(--radius-control);\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        color: var(--text-muted);\n        font-size: 13px;\n      }\n\n      .alert-section {\n        background: var(--bg-card);\n        border: var(--border-width) solid var(--border);\n        border-radius: var(--radius-card);\n        padding: calc(var(--space-unit) * 2);\n        box-shadow: var(--shadow-card);\n      }\n\n      .alert-list {\n        display: flex;\n        flex-direction: column;\n        gap: calc(var(--space-unit) * 1);\n        max-height: 300px;\n        overflow-y: auto;\n      }\n\n      .alert-item {\n        padding: calc(var(--space-unit) * 1);\n        border-left: 4px solid #dc2626;\n        background: rgba(220, 38, 38, 0.05);\n        border-radius: var(--radius-control);\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n        cursor: pointer;\n        transition: background-color var(--motion-duration);\n      }\n\n      .alert-item:hover {\n        background: rgba(220, 38, 38, 0.1);\n      }\n\n      .alert-item.warning {\n        border-left-color: #f59e0b;\n        background: rgba(245, 158, 11, 0.05);\n      }\n\n      .alert-item.warning:hover {\n        background: rgba(245, 158, 11, 0.1);\n      }\n\n      .alert-text {\n        font-size: 12px;\n        color: var(--text);\n      }\n\n      .alert-icon {\n        font-size: 16px;\n      }\n\n      .right-pane {\n        display: flex;\n        flex-direction: column;\n        gap: calc(var(--space-unit) * 2);\n      }\n\n      .detail-panel {\n        background: var(--bg-card);\n        border: var(--border-width) solid var(--border);\n        border-radius: var(--radius-card);\n        padding: calc(var(--space-unit) * 2);\n        box-shadow: var(--shadow-card);\n      }\n\n      .detail-content {\n        display: flex;\n        flex-direction: column;\n        gap: calc(var(--space-unit) * 1);\n      }\n\n      .detail-info {\n        display: flex;\n        flex-direction: column;\n        gap: calc(var(--space-unit) * 1);\n      }\n\n      .detail-row {\n        display: grid;\n        grid-template-columns: 100px 1fr;\n        gap: calc(var(--space-unit) * 1);\n        font-size: 12px;\n      }\n\n      .detail-row label {\n        font-weight: 600;\n        color: var(--text-muted);\n      }\n\n      .detail-row span {\n        color: var(--text);\n        word-break: break-word;\n      }\n\n      .tab-group {\n        display: flex;\n        gap: calc(var(--space-unit) * 0.5);\n        margin-bottom: calc(var(--space-unit) * 1.5);\n        border-bottom: var(--border-width) solid var(--border);\n      }\n\n      .month-tab {\n        padding: calc(var(--space-unit) * 1) calc(var(--space-unit) * 1.5);\n        border: none;\n        background: none;\n        cursor: pointer;\n        font-size: 12px;\n        color: var(--text-muted);\n        border-bottom: 3px solid transparent;\n        transition: all var(--motion-duration);\n        white-space: nowrap;\n      }\n\n      .month-tab:hover {\n        color: var(--text);\n      }\n\n      .month-tab.active {\n        color: var(--primary);\n        border-bottom-color: var(--primary);\n      }\n\n      .search-result {\n        background: var(--bg-card);\n        border: var(--border-width) solid var(--border);\n        border-radius: var(--radius-control);\n        padding: calc(var(--space-unit) * 1);\n        font-size: 12px;\n        color: var(--text);\n        margin-top: calc(var(--space-unit) * 0.5);\n      }\n\n      .checkbox-group {\n        display: flex;\n        align-items: center;\n        gap: calc(var(--space-unit) * 0.5);\n        margin: calc(var(--space-unit) * 0.5) 0;\n      }\n\n      .checkbox-group input[type=\"checkbox\"] {\n        cursor: pointer;\n      }\n\n      .checkbox-label {\n        font-size: 12px;\n        color: var(--text);\n        cursor: pointer;\n      }\n\n      @media (max-width: 1400px) {\n        .main-container {\n          grid-template-columns: 1fr 1fr;\n        }\n        .right-pane {\n          grid-column: 1 / -1;\n        }\n      }\n    </style>\n\n    <div class=\"page-header\">\n      <div class=\"breadcrumb\">\n        <span>顧客ポータル</span>\n        <span>></span>\n        <span>ベンダー評価</span>\n      </div>\n      <div class=\"page-title\">ベンダー評価ダッシュボード</div>\n    </div>\n\n    <div class=\"main-container\">\n      <!-- 左ペイン: ベンダー評価スコア一覧表 -->\n      <div class=\"left-pane\">\n        <div class=\"search-section\">\n          <div class=\"search-group\">\n            <div class=\"form-group\" style=\"flex: 1;\">\n              <label class=\"form-label\">ベンダー検索</label>\n              <input type=\"text\" class=\"form-input\" placeholder=\"ベンダー名で検索\" id=\"vendorSearchInput\">\n            </div>\n            <button class=\"button button-primary\" id=\"searchBtn\">検索</button>\n          </div>\n        </div>\n\n        <div class=\"table-container\">\n          <div class=\"scrollable-table\">\n            <table id=\"vendorTable\">\n              <thead>\n                <tr>\n                  <th style=\"width: 30px;\"></th>\n                  <th>ベンダー名</th>\n                  <th>総合スコア</th>\n                  <th>納期達成率</th>\n                  <th>対応速度</th>\n                  <th>品質</th>\n                  <th>ステータス</th>\n                </tr>\n              </thead>\n              <tbody>\n                <tr data-vendor-id=\"vnd-001\">\n                  <td><input type=\"checkbox\" name=\"vendorCompare\" value=\"vnd-001\"></td>\n                  <td>トップ電子</td>\n                  <td>92</td>\n                  <td>95%</td>\n                  <td>8.5</td>\n                  <td>9.0</td>\n                  <td>有効</td>\n                </tr>\n                <tr data-vendor-id=\"vnd-004\">\n                  <td><input type=\"checkbox\" name=\"vendorCompare\" value=\"vnd-004\"></td>\n                  <td>フジ電機工業</td>\n                  <td>88</td>\n                  <td>92%</td>\n                  <td>9.0</td>\n                  <td>8.5</td>\n                  <td>有効</td>\n                </tr>\n                <tr data-vendor-id=\"vnd-002\">\n                  <td><input type=\"checkbox\" name=\"vendorCompare\" value=\"vnd-002\"></td>\n                  <td>東海物流センター</td>\n                  <td>85</td>\n                  <td>88%</td>\n                  <td>8.0</td>\n                  <td>8.5</td>\n                  <td>有効</td>\n                </tr>\n                <tr data-vendor-id=\"vnd-005\">\n                  <td><input type=\"checkbox\" name=\"vendorCompare\" value=\"vnd-005\"></td>\n                  <td>山田電子部品</td>\n                  <td>81</td>\n                  <td>85%</td>\n                  <td>8.8</td>\n                  <td>7.8</td>\n                  <td>有効</td>\n                </tr>\n                <tr data-vendor-id=\"vnd-003\">\n                  <td><input type=\"checkbox\" name=\"vendorCompare\" value=\"vnd-003\"></td>\n                  <td>グローバルテック関西</td>\n                  <td>78</td>\n                  <td>80%</td>\n                  <td>7.5</td>\n                  <td>8.0</td>\n                  <td>有効</td>\n                </tr>\n                <tr data-vendor-id=\"vnd-006\">\n                  <td><input type=\"checkbox\" name=\"vendorCompare\" value=\"vnd-006\"></td>\n                  <td>アジア流通パートナーズ</td>\n                  <td>72</td>\n                  <td>75%</td>\n                  <td>7.0</td>\n                  <td>7.5</td>\n                  <td>有効</td>\n                </tr>\n              </tbody>\n            </table>\n          </div>\n        </div>\n\n        <button class=\"button button-secondary\" id=\"compareBtn\">比較表示</button>\n      </div>\n\n      <!-- 中央ペイン: グラフとメトリクス -->\n      <div class=\"middle-pane\">\n        <div class=\"card\">\n          <div class=\"section-title\">月次納期達成率トレンド（直近3ヶ月）</div>\n          <div class=\"chart-container\" style=\"height: 250px;\">\n            グラフプレースホルダー（11月: 92%, 10月: 89%, 9月: 87%）\n          </div>\n        </div>\n\n        <div class=\"card\">\n          <div class=\"section-title\">パフォーマンス指標</div>\n          <div class=\"metric-cards\">\n            <div class=\"metric-card\">\n              <div class=\"metric-label\">平均納期達成率</div>\n              <div class=\"metric-value\">89%</div>\n              <div class=\"metric-unit\">直近30日</div>\n            </div>\n            <div class=\"metric-card\">\n              <div class=\"metric-label\">平均対応速度</div>\n              <div class=\"metric-value\">8.1</div>\n              <div class=\"metric-unit\">スコア/10</div>\n            </div>\n            <div class=\"metric-card\">\n              <div class=\"metric-label\">平均品質スコア</div>\n              <div class=\"metric-value\">8.3</div>\n              <div class=\"metric-unit\">スコア/10</div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"alert-section\">\n          <div class=\"section-title\">通知・アラート（最新5件）</div>\n          <div class=\"alert-list\">\n            <div class=\"alert-item\">\n              <span class=\"alert-text\">🔴 アジア流通パートナーズ: 納期遅延警告（予定: 2026-11-15）</span>\n              <button class=\"button button-secondary\" style=\"padding: 4px 8px; height: auto;\">詳細</button>\n            </div>\n            <div class=\"alert-item warning\">\n              <span class=\"alert-text\">🟡 グローバルテック関西: 品質不良率上昇（2.5% → 3.1%）</span>\n              <button class=\"button button-secondary\" style=\"padding: 4px 8px; height: auto;\">詳細</button>\n            </div>\n            <div class=\"alert-item\">\n              <span class=\"alert-text\">🔴 東海物流センター: 対応遅延（平均12時間 → 16時間）</span>\n              <button class=\"button button-secondary\" style=\"padding: 4px 8px; height: auto;\">詳細</button>\n            </div>\n            <div class=\"alert-item warning\">\n              <span class=\"alert-text\">🟡 山田電子部品: 納期達成率低下（87% → 82%）</span>\n              <button class=\"button button-secondary\" style=\"padding: 4px 8px; height: auto;\">詳細</button>\n            </div>\n            <div class=\"alert-item\">\n              <span class=\"alert-text\">✅ トップ電子: 納期達成率新記録達成（95%）</span>\n              <button class=\"button button-secondary\" style=\"padding: 4px 8px; height: auto;\">詳細</button>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- 右ペイン: 詳細情報・検索・履歴 -->\n      <div class=\"right-pane\">\n        <!-- 詳細情報パネル -->\n        <div class=\"detail-panel\">\n          <div class=\"section-title\">選択ベンダーの詳細情報</div>\n          <div class=\"detail-content\">\n            <div class=\"search-result\">（テーブル行をクリックして選択）</div>\n          </div>\n        </div>\n\n        <!-- 代替仕入先検索 -->\n        <div class=\"detail-panel\">\n          <div class=\"section-title\">代替仕入先検索</div>\n          <div class=\"form-group\" style=\"margin-bottom: calc(var(--space-unit) * 1);\">\n            <label class=\"form-label\">検索条件</label>\n            <input type=\"text\" class=\"form-input\" placeholder=\"商品カテゴリ・仕様で検索\" style=\"margin-bottom: calc(var(--space-unit) * 0.5);\">\n            <button class=\"button button-primary\" style=\"width: 100%;\">検索</button>\n          </div>\n          <div class=\"search-result\">検索結果表示エリア</div>\n        </div>\n\n        <!-- 評価履歴 -->\n        <div class=\"detail-panel\">\n          <div class=\"section-title\">評価履歴</div>\n          <div class=\"tab-group\">\n            <button class=\"month-tab active\" data-month=\"202611\">11月</button>\n            <button class=\"month-tab\" data-month=\"202610\">10月</button>\n            <button class=\"month-tab\" data-month=\"202609\">9月</button>\n          </div>\n          <div class=\"table-container\" style=\"max-height: 300px;\">\n            <div class=\"scrollable-table\">\n              <table id=\"evaluationHistoryTable\">\n                <thead>\n                  <tr>\n                    <th>評価日</th>\n                    <th>スコア</th>\n                    <th>評価者</th>\n                  </tr>\n                </thead>\n                <tbody>\n                  <tr data-month=\"202611\">\n                    <td>2026-11-15</td>\n                    <td>92</td>\n                    <td>営業1課</td>\n                  </tr>\n                  <tr data-month=\"202611\">\n                    <td>2026-11-10</td>\n                    <td>90</td>\n                    <td>営業1課</td>\n                  </tr>\n                  <tr data-month=\"202610\">\n                    <td>2026-10-28</td>\n                    <td>88</td>\n                    <td>営業2課</td>\n                  </tr>\n                  <tr data-month=\"202610\">\n                    <td>2026-10-15</td>\n                    <td>87</td>\n                    <td>営業1課</td>\n                  </tr>\n                  <tr data-month=\"202609\">\n                    <td>2026-09-30</td>\n                    <td>85</td>\n                    <td>営業2課</td>\n                  </tr>\n                </tbody>\n              </table>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  ",
      "initJs": "function(container, apiUrl, tables) {\n  const vendorTableRows = container.querySelectorAll('#vendorTable tbody tr');\n  const historicalMonths = container.querySelectorAll('.month-tab');\n  const detailPanel = container.querySelector('.detail-panel');\n  const searchBtn = container.querySelector('#searchBtn');\n  const compareBtn = container.querySelector('#compareBtn');\n  const vendorSearchInput = container.querySelector('#vendorSearchInput');\n  const selectedVendorCheckboxes = container.querySelectorAll('input[name=\"vendorCompare\"]');\n  \n  let selectedRowEl = null;\n  let selectedVendors = [];\n  \n  vendorTableRows.forEach(row => {\n    row.addEventListener('click', () => {\n      if (selectedRowEl) selectedRowEl.classList.remove('active');\n      selectedRowEl = row;\n      row.classList.add('active');\n      const vendorName = row.querySelector('td:nth-child(2)').textContent;\n      const vendorId = row.getAttribute('data-vendor-id');\n      updateDetailPanel(vendorName, vendorId);\n    });\n  });\n  \n  historicalMonths.forEach(tab => {\n    tab.addEventListener('click', () => {\n      container.querySelectorAll('.month-tab').forEach(t => t.classList.remove('active'));\n      tab.classList.add('active');\n      const month = tab.getAttribute('data-month');\n      filterHistoryByMonth(month);\n    });\n  });\n  \n  if (searchBtn) {\n    searchBtn.addEventListener('click', () => {\n      const searchTerm = vendorSearchInput.value.toLowerCase();\n      filterVendorTable(searchTerm);\n    });\n    vendorSearchInput.addEventListener('keydown', (e) => {\n      if (e.key === 'Enter') searchBtn.click();\n    });\n  }\n  \n  if (compareBtn) {\n    compareBtn.addEventListener('click', () => {\n      selectedVendors = [];\n      selectedVendorCheckboxes.forEach(cb => {\n        if (cb.checked) selectedVendors.push(cb.value);\n      });\n      if (selectedVendors.length > 0) {\n        showComparisonModal(selectedVendors);\n      }\n    });\n  }\n  \n  function updateDetailPanel(vendorName, vendorId) {\n    const detailContent = container.querySelector('.detail-content');\n    if (detailContent) {\n      detailContent.innerHTML = '<div class=\"detail-info\"><div class=\"detail-row\"><label>ベンダー名</label><span>' + vendorName + '</span></div><div class=\"detail-row\"><label>ステータス</label><span>有効</span></div><div class=\"detail-row\"><label>評価件数</label><span>--</span></div><div class=\"detail-row\"><label>連絡先</label><span>--</span></div></div>';\n    }\n  }\n  \n  function filterVendorTable(searchTerm) {\n    vendorTableRows.forEach(row => {\n      const vendorName = row.querySelector('td:nth-child(2)').textContent.toLowerCase();\n      row.style.display = vendorName.includes(searchTerm) ? '' : 'none';\n    });\n  }\n  \n  function filterHistoryByMonth(month) {\n    const historyRows = container.querySelectorAll('#evaluationHistoryTable tbody tr');\n    historyRows.forEach(row => {\n      const rowMonth = row.getAttribute('data-month');\n      row.style.display = rowMonth === month ? '' : 'none';\n    });\n  }\n  \n  function showComparisonModal(vendorIds) {\n    alert('比較機能: ' + vendorIds.join(', ') + ' を比較します');\n  }\n}",
