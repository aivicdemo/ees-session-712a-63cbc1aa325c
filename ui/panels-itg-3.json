  "shellHtml": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>新EES - 顧客ポータル・ベンダー評価システム</title>\n  <style>\n:root {\n  --primary: #2563eb;\n  --primary-hover: #1d4ed8;\n  --bg-main: #f8fafc;\n  --bg-card: #ffffff;\n  --bg-sidebar: #f1f5f9;\n  --border: #e2e8f0;\n  --border-width: 1px;\n  --text: #1e293b;\n  --text-muted: #64748b;\n  --top-bar-bg: #1e293b;\n  --top-bar-border: #0f172a;\n  --top-bar-text: #f1f5f9;\n  --font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"Roboto\", \"Oxygen\", \"Ubuntu\", \"Cantarell\", \"Fira Sans\", \"Droid Sans\", \"Helvetica Neue\", sans-serif;\n  --space-unit: 8px;\n  --control-height: 36px;\n  --radius-card: 6px;\n  --radius-control: 4px;\n  --shadow-card: 0 1px 3px rgba(15, 23, 42, 0.08), 0 1px 2px rgba(15, 23, 42, 0.04);\n  --motion-duration: 200ms;\n  --surface-texture: linear-gradient(135deg, rgba(226, 232, 240, 0.3) 0%, rgba(226, 232, 240, 0) 100%);\n  --surface-texture-size: 100% 100%;\n  --surface-texture-position: 0 0;\n}\n\n* {\n  margin: 0;\n  padding: 0;\n  box-sizing: border-box;\n}\n\nhtml, body {\n  height: 100%;\n  font-family: var(--font-family);\n  color: var(--text);\n  background-color: var(--bg-main);\n}\n\nbody {\n  display: flex;\n  flex-direction: column;\n}\n\n[data-aivic-shell-pattern=\"sidebar\"] {\n  display: flex;\n  height: 100vh;\n  overflow: hidden;\n}\n\n.shell-top-bar {\n  position: fixed;\n  top: 0;\n  left: 0;\n  right: 0;\n  height: 56px;\n  background-color: var(--top-bar-bg);\n  border-bottom: var(--border-width) solid var(--top-bar-border);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 0 calc(var(--space-unit) * 2);\n  z-index: 100;\n  box-shadow: var(--shadow-card);\n}\n\n.shell-logo {\n  display: flex;\n  align-items: center;\n  gap: calc(var(--space-unit) * 1.5);\n  font-size: 14px;\n  font-weight: 600;\n  color: var(--top-bar-text);\n}\n\n.shell-logo-icon {\n  width: 28px;\n  height: 28px;\n  background-color: var(--primary);\n  border-radius: var(--radius-control);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 12px;\n  font-weight: 700;\n  color: white;\n}\n\n.shell-user-area {\n  display: flex;\n  align-items: center;\n  gap: calc(var(--space-unit) * 1.5);\n}\n\n.shell-user-avatar {\n  width: 32px;\n  height: 32px;\n  border-radius: 50%;\n  background-color: var(--primary);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 13px;\n  font-weight: 600;\n  color: white;\n}\n\n.shell-user-name {\n  font-size: 13px;\n  color: var(--top-bar-text);\n}\n\n.shell-logout {\n  font-size: 12px;\n  color: var(--top-bar-text);\n  text-decoration: none;\n  transition: color var(--motion-duration);\n}\n\n.shell-logout:hover {\n  color: var(--primary);\n}\n\n.shell-sidebar {\n  position: fixed;\n  left: 0;\n  top: 56px;\n  bottom: 0;\n  width: 240px;\n  background-color: var(--bg-sidebar);\n  border-right: var(--border-width) solid var(--border);\n  overflow-y: auto;\n  padding: calc(var(--space-unit) * 2) 0;\n  z-index: 99;\n}\n\n.shell-nav {\n  display: flex;\n  flex-direction: column;\n  gap: 0;\n}\n\n.shell-nav-item {\n  display: block;\n  padding: calc(var(--space-unit) * 1.5) calc(var(--space-unit) * 2);\n  font-size: 13px;\n  color: var(--text);\n  text-decoration: none;\n  cursor: pointer;\n  transition: background-color var(--motion-duration), color var(--motion-duration);\n  border-left: 3px solid transparent;\n}\n\n.shell-nav-item:hover {\n  background-color: rgba(37, 99, 235, 0.08);\n  color: var(--primary);\n}\n\n.shell-nav-item.aivic-active {\n  background-color: rgba(37, 99, 235, 0.12);\n  color: var(--primary);\n  border-left-color: var(--primary);\n  font-weight: 500;\n}\n\n.content-area {\n  margin-left: 240px;\n  margin-top: 56px;\n  flex: 1;\n  overflow-y: auto;\n  background-color: var(--bg-main);\n  background-image: var(--surface-texture);\n  background-size: var(--surface-texture-size);\n  background-position: var(--surface-texture-position);\n}\n\n[data-aivic-panel] {\n  width: 100%;\n  min-height: 100%;\n}\n\n.shell-scrollbar {\n  scrollbar-width: thin;\n  scrollbar-color: rgba(100, 116, 139, 0.3) transparent;\n}\n\n.shell-scrollbar::-webkit-scrollbar {\n  width: 6px;\n}\n\n.shell-scrollbar::-webkit-scrollbar-track {\n  background: transparent;\n}\n\n.shell-scrollbar::-webkit-scrollbar-thumb {\n  background-color: rgba(100, 116, 139, 0.3);\n  border-radius: 3px;\n}\n\n.shell-scrollbar::-webkit-scrollbar-thumb:hover {\n  background-color: rgba(100, 116, 139, 0.5);\n}\n  </style>\n  <!--AIVIC_GLOBALS-->\n</head>\n<body>\n  <div data-aivic-shell-pattern=\"sidebar\" data-aivic-nav-position=\"left\" data-aivic-density=\"compact\">\n    <header class=\"shell-top-bar\">\n      <div class=\"shell-logo\">\n        <div class=\"shell-logo-icon\">E</div>\n        <span>新EES</span>\n      </div>\n      <div class=\"shell-user-area\">\n        <div class=\"shell-user-avatar\">U</div>\n        <div class=\"shell-user-name\">ユーザー</div>\n        <a href=\"./login.html\" class=\"shell-logout\">ログアウト</a>\n      </div>\n    </header>\n\n    <aside class=\"shell-sidebar shell-scrollbar\">\n      <nav class=\"shell-nav\">\n        <a class=\"shell-nav-item aivic-active\" data-aivic-nav=\"scr-1794401466084\" onclick=\"window.showScreen('scr-1794401466084')\">ベンダー評価ダッシュボード</a>\n      </nav>\n    </aside>\n\n    <main class=\"content-area shell-scrollbar\">\n      <div data-aivic-panel=\"scr-1794401466084\"></div>\n    </main>\n  </div>\n\n  <!--AIVIC_RUNTIME-->\n</body>\n</html>",
