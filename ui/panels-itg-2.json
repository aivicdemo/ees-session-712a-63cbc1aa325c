  "screenPanels": [
    {
      "screenId": "scr-1794401382374",
      "panelHtml": "\n    <div class=\"page-header\">\n      <div>\n        <div class=\"breadcrumb\">\n          <span>顧客取引履歴・見積管理</span>\n          <span>></span>\n          <span>顧客検索</span>\n        </div>\n        <div class=\"page-title\">顧客取引履歴・見積管理ワークスペース</div>\n      </div>\n    </div>\n\n    <div class=\"main-container\">\n      <div class=\"left-column\">\n        <!-- 顧客検索セクション -->\n        <div class=\"search-section\">\n          <div class=\"search-group\">\n            <div class=\"form-group\" style=\"flex: 1;\">\n              <label class=\"form-label\">顧客検索</label>\n              <input type=\"text\" class=\"form-input\" placeholder=\"顧客コードまたは顧客名で検索\" id=\"customerSearchInput\">\n            </div>\n            <button class=\"button button-primary\" id=\"searchBtn\" style=\"align-self: flex-end;\">検索</button>\n            <button class=\"button button-secondary\" id=\"masterSearchBtn\" style=\"align-self: flex-end;\">顧客マスタ統合検索</button>\n          </div>\n        </div>\n\n        <!-- 取引履歴テーブル -->\n        <div>\n          <h3 class=\"section-title\">顧客別取引履歴</h3>\n          <div class=\"table-container\">\n            <div class=\"scrollable-table\">\n              <table id=\"transactionTable\">\n                <thead>\n                  <tr>\n                    <th>取引日</th>\n                    <th>取引種別</th>\n                    <th>取引金額</th>\n                    <th>ステータス</th>\n                  </tr>\n                </thead>\n                <tbody>\n                  <tr data-transaction-id=\"tx-001\">\n                    <td>2026-11-10</td>\n                    <td>受注</td>\n                    <td>¥1,500,000</td>\n                    <td>完了</td>\n                  </tr>\n                  <tr data-transaction-id=\"tx-002\">\n                    <td>2026-11-05</td>\n                    <td>見積</td>\n                    <td>¥2,300,000</td>\n                    <td>未処理</td>\n                  </tr>\n                  <tr data-transaction-id=\"tx-003\">\n                    <td>2026-11-01</td>\n                    <td>受注</td>\n                    <td>¥980,000</td>\n                    <td>完了</td>\n                  </tr>\n                  <tr data-transaction-id=\"tx-004\">\n                    <td>2026-10-28</td>\n                    <td>請求</td>\n                    <td>¥1,500,000</td>\n                    <td>完了</td>\n                  </tr>\n                </tbody>\n              </table>\n            </div>\n          </div>\n        </div>\n\n        <!-- 見積履歴テーブル -->\n        <div>\n          <h3 class=\"section-title\">顧客別見積履歴</h3>\n          <div class=\"table-container\">\n            <div class=\"scrollable-table-250\">\n              <table id=\"quoteTable\">\n                <thead>\n                  <tr>\n                    <th>見積日</th>\n                    <th>見積金額</th>\n                    <th>ステータス</th>\n                    <th>受注転換</th>\n                  </tr>\n                </thead>\n                <tbody>\n                  <tr data-quote-id=\"qt-001\">\n                    <td>2026-11-05</td>\n                    <td>¥2,300,000</td>\n                    <td>有効</td>\n                    <td>-</td>\n                  </tr>\n                  <tr data-quote-id=\"qt-002\">\n                    <td>2026-10-20</td>\n                    <td>¥1,800,000</td>\n                    <td>受注済</td>\n                    <td>済</td>\n                  </tr>\n                  <tr data-quote-id=\"qt-003\">\n                    <td>2026-10-15</td>\n                    <td>¥950,000</td>\n                    <td>失効</td>\n                    <td>-</td>\n                  </tr>\n                </tbody>\n              </table>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"right-column\">\n        <!-- 原価推移グラフ -->\n        <div>\n          <h3 class=\"section-title\">原価推移グラフ</h3>\n          <div class=\"chart-container\" id=\"costChart\">\n            グラフプレースホルダー\n          </div>\n        </div>\n\n        <!-- 詳細パネル -->\n        <div>\n          <h3 class=\"section-title\">詳細情報</h3>\n          <div class=\"detail-panel\">\n            <div class=\"tabs\">\n              <button class=\"tab active\" data-tab=\"transaction\">受注情報</button>\n              <button class=\"tab\" data-tab=\"quote\">見積情報</button>\n            </div>\n\n            <div id=\"tab-transaction\" class=\"tab-content active\">\n              <div class=\"detail-row\">\n                <div class=\"detail-label\">顧客名</div>\n                <div class=\"detail-value\">サンプル顧客A</div>\n              </div>\n              <div class=\"detail-row\">\n                <div class=\"detail-label\">取引日</div>\n                <div class=\"detail-value\">2026-11-10</div>\n              </div>\n              <div class=\"detail-row\">\n                <div class=\"detail-label\">取引金額</div>\n                <div class=\"detail-value\">¥1,500,000</div>\n              </div>\n              <div class=\"detail-row\">\n                <div class=\"detail-label\">備考</div>\n                <div class=\"detail-value\">-</div>\n              </div>\n            </div>\n\n            <div id=\"tab-quote\" class=\"tab-content\">\n              <div class=\"detail-row\">\n                <div class=\"detail-label\">見積日</div>\n                <div class=\"detail-value\">2026-11-05</div>\n              </div>\n              <div class=\"detail-row\">\n                <div class=\"detail-label\">有効期限</div>\n                <div class=\"detail-value\">2026-12-05</div>\n              </div>\n              <div class=\"detail-row\">\n                <div class=\"detail-label\">見積金額</div>\n                <div class=\"detail-value\">¥2,300,000</div>\n              </div>\n              <div class=\"detail-row\">\n                <div class=\"detail-label\">商品明細</div>\n                <div class=\"detail-value\">3品目</div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  ",
      "initJs": "function(container, apiUrl, tables) {\n  const tabs = container.querySelectorAll('.tab');\n  const tabContents = container.querySelectorAll('.tab-content');\n  const transactionRows = container.querySelectorAll('#transactionTable tbody tr');\n  const quoteRows = container.querySelectorAll('#quoteTable tbody tr');\n\n  tabs.forEach(tab => {\n    tab.addEventListener('click', () => {\n      tabContents.forEach(content => content.classList.remove('active'));\n      tabs.forEach(t => t.classList.remove('active'));\n      const tabId = 'tab-' + tab.dataset.tab;\n      container.querySelector('#' + tabId).classList.add('active');\n      tab.classList.add('active');\n    });\n  });\n\n  transactionRows.forEach(row => {\n    row.addEventListener('click', () => {\n      const transactionTab = container.querySelector('[data-tab=\"transaction\"]');\n      if (transactionTab) transactionTab.click();\n    });\n  });\n\n  quoteRows.forEach(row => {\n    row.addEventListener('click', () => {\n      const quoteTab = container.querySelector('[data-tab=\"quote\"]');\n      if (quoteTab) quoteTab.click();\n    });\n  });\n}",
      "method": "ai"
    },
    {
      "screenId": "scr-1794401391211",
      "panelHtml": "\n    <div class=\"page-header\">\n      <div>\n        <div class=\"breadcrumb\">\n          <span>見積管理</span>\n          <span>></span>\n          <span>見積作成・管理</span>\n        </div>\n        <div class=\"page-title\">見積作成・管理</div>\n      </div>\n    </div>\n\n    <div class=\"main-container\">\n      <!-- 見積依頼一覧 -->\n      <div>\n        <h3 class=\"section-title\">見積依頼一覧</h3>\n        <div class=\"quote-list-container\">\n          <div class=\"scrollable-table\">\n            <table id=\"quoteListTable\">\n              <thead>\n                <tr>\n                  <th>見積ID</th>\n                  <th>顧客名</th>\n                  <th>見積日</th>\n                  <th>ステータス</th>\n                  <th>見積金額</th>\n                </tr>\n              </thead>\n              <tbody>\n                <tr data-quote-id=\"qt-001\">\n                  <td>QT-001</td>\n                  <td>顧客A</td>\n                  <td>2026-11-10</td>\n                  <td>新規</td>\n                  <td>¥1,200,000</td>\n                </tr>\n                <tr data-quote-id=\"qt-002\">\n                  <td>QT-002</td>\n                  <td>顧客B</td>\n                  <td>2026-11-08</td>\n                  <td>発行済</td>\n                  <td>¥800,000</td>\n                </tr>\n                <tr data-quote-id=\"qt-003\">\n                  <td>QT-003</td>\n                  <td>顧客C</td>\n                  <td>2026-11-05</td>\n                  <td>失効</td>\n                  <td>¥2,500,000</td>\n                </tr>\n              </tbody>\n            </table>\n          </div>\n        </div>\n        <div style=\"padding: calc(var(--space-unit) * 1.5); background-color: var(--bg-card); border: var(--border-width) solid var(--border); border-top: none; border-radius: 0 0 var(--radius-card) var(--radius-card);\">\n          <button class=\"button button-primary\" id=\"newQuoteBtn\" style=\"width: 100%;\">見積依頼登録</button>\n        </div>\n      </div>\n\n      <!-- 見積作成フォーム -->\n      <div>\n        <h3 class=\"section-title\">見積作成フォーム</h3>\n        <div class=\"form-section\">\n          <div class=\"form-row\">\n            <div class=\"form-group\" style=\"flex: 1;\">\n              <label class=\"form-label\">顧客選択 *</label>\n              <select class=\"form-select\" id=\"customerSelect\">\n                <option value=\"\">顧客を選択してください</option>\n                <option value=\"cust-001\">顧客A（C-001）</option>\n                <option value=\"cust-002\">顧客B（C-002）</option>\n                <option value=\"cust-003\">顧客C（C-003）</option>\n              </select>\n            </div>\n            <div class=\"form-group\" style=\"flex: 1;\">\n              <label class=\"form-label\">見積依頼日付 *</label>\n              <input type=\"date\" class=\"form-input\" id=\"quoteDate\">\n            </div>\n          </div>\n\n          <div class=\"form-row\">\n            <div class=\"form-group\">\n              <label class=\"form-label\">見積依頼内容（備考）</label>\n              <textarea class=\"form-textarea\" id=\"quoteRemark\" placeholder=\"見積に関する特記事項があればご入力ください\"></textarea>\n            </div>\n          </div>\n\n          <h3 class=\"section-title\" style=\"margin-top: calc(var(--space-unit) * 2);\">商品選択</h3>\n          <div class=\"table-container\">\n            <div class=\"scrollable-table-250\">\n              <table id=\"productTable\">\n                <thead>\n                  <tr>\n                    <th>商品コード</th>\n                    <th>商品名</th>\n                    <th>単位</th>\n                    <th>数量</th>\n                    <th>単価</th>\n                    <th>小計</th>\n                  </tr>\n                </thead>\n                <tbody>\n                  <tr data-product-id=\"prod-001\">\n                    <td>PD-001</td>\n                    <td>商品A</td>\n                    <td>個</td>\n                    <td><input type=\"number\" class=\"form-input quantity-input\" value=\"10\" min=\"1\"></td>\n                    <td class=\"price-display\">¥10,000</td>\n                    <td class=\"price-display\">¥100,000</td>\n                  </tr>\n                  <tr data-product-id=\"prod-002\">\n                    <td>PD-002</td>\n                    <td>商品B</td>\n                    <td>箱</td>\n                    <td><input type=\"number\" class=\"form-input quantity-input\" value=\"5\" min=\"1\"></td>\n                    <td class=\"price-display\">¥20,000</td>\n                    <td class=\"price-display\">¥100,000</td>\n                  </tr>\n                </tbody>\n              </table>\n            </div>\n          </div>\n        </div>\n\n        <!-- 小計・税額・合計 -->\n        <div class=\"totals-section\">\n          <div class=\"total-row\">\n            <div class=\"total-label\">小計（税抜き）</div>\n            <div class=\"total-value\">¥200,000</div>\n          </div>\n          <div class=\"total-row\">\n            <div class=\"total-label\">消費税（10%）</div>\n            <div class=\"total-value\">¥20,000</div>\n          </div>\n          <div class=\"total-row\" style=\"border-top: var(--border-width) solid var(--border); padding-top: calc(var(--space-unit) * 1);\">\n            <div class=\"total-label\">見積合計金額</div>\n            <div class=\"total-value\" style=\"font-size: 16px;\">¥220,000</div>\n          </div>\n        </div>\n      </div>\n\n      <!-- 見積書プレビュー -->\n      <div>\n        <h3 class=\"section-title\">見積書プレビュー</h3>\n        <div class=\"preview-section\">\n          <div class=\"preview-placeholder\" id=\"previewArea\">\n            プレビュー表示エリア\n          </div>\n          <div class=\"button-group\">\n            <button class=\"button button-secondary\" id=\"previewBtn\" style=\"flex: 1;\">見積書プレビュー</button>\n            <button class=\"button button-primary\" id=\"downloadBtn\" style=\"flex: 1;\">PDF出力</button>\n          </div>\n        </div>\n      </div>\n    </div>\n  ",
      "initJs": "function(container, apiUrl, tables) {\n  const quantityInputs = container.querySelectorAll('.quantity-input');\n  const productTable = container.querySelector('#productTable tbody');\n  const previewBtn = container.querySelector('#previewBtn');\n  const downloadBtn = container.querySelector('#downloadBtn');\n  const newQuoteBtn = container.querySelector('#newQuoteBtn');\n  const quoteListRows = container.querySelectorAll('#quoteListTable tbody tr');\n\n  function updateTotals() {\n    let subtotal = 0;\n    const rows = productTable.querySelectorAll('tr');\n    rows.forEach(row => {\n      const quantity = parseInt(row.querySelector('.quantity-input').value) || 0;\n      const priceText = row.querySelectorAll('.price-display')[0].textContent;\n      const price = parseInt(priceText.replace(/[^0-9]/g, '')) || 0;\n      subtotal += quantity * price;\n    });\n    const tax = Math.floor(subtotal * 0.1);\n    const total = subtotal + tax;\n    const totalsSection = container.querySelector('.totals-section');\n    const totalRows = totalsSection.querySelectorAll('.total-row');\n    if (totalRows.length >= 3) {\n      totalRows[0].querySelector('.total-value').textContent = '¥' + subtotal.toLocaleString();\n      totalRows[1].querySelector('.total-value').textContent = '¥' + tax.toLocaleString();\n      totalRows[2].querySelector('.total-value').textContent = '¥' + total.toLocaleString();\n    }\n  }\n\n  quantityInputs.forEach(input => {\n    input.addEventListener('change', updateTotals);\n  });\n\n  previewBtn.addEventListener('click', () => {\n    const previewArea = container.querySelector('#previewArea');\n    previewArea.innerHTML = '<div style=\"padding: 16px; font-size: 12px; color: var(--text);\"><strong>見積書</strong><br>顧客: 顧客A<br>見積日: ' + new Date().toLocaleDateString('ja-JP') + '<br>商品明細: 2品目<br>合計: ¥220,000</div>';\n  });\n\n  downloadBtn.addEventListener('click', () => {\n    alert('PDF出力機能（実装予定）');\n  });\n\n  newQuoteBtn.addEventListener('click', () => {\n    container.querySelector('#customerSelect').value = '';\n    container.querySelector('#quoteDate').value = '';\n    container.querySelector('#quoteRemark').value = '';\n    quantityInputs.forEach(input => input.value = input.defaultValue || 1);\n    updateTotals();\n  });\n\n  quoteListRows.forEach(row => {\n    row.addEventListener('click', () => {\n      const quoteId = row.dataset.quoteId;\n      container.querySelector('#customerSelect').value = 'cust-001';\n      updateTotals();\n    });\n  });\n}",
      "method": "ai"
    }
  ],
